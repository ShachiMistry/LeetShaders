{
  "name": "leetshaders",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-native GLSL shader coding challenge platform with a hybrid AI-powered judging system.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/backend/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@emotion/react": "11.13.5",
    "@emotion/styled": "11.13.5",
    "@monaco-editor/react": "4.7.0",
    "@mui/icons-material": "7.3.9",
    "@mui/material": "7.3.9",
    "@supabase/supabase-js": "2.47.10",
    "monaco-editor": "0.52.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.1.1",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "@vitejs/plugin-react": "4.3.4",
    "dotenv": "16.4.7",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
  }
}
